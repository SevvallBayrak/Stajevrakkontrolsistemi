@model List<Application>
<div class="table-wrap">
    <table class="table">
        <thead><tr><th>#</th><th>Öğrenci</th><th>Firma</th><th>Staj tarihleri</th><th>Evrak</th><th>Rapor</th><th>Statü</th><th>Güncelleme</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            var d = a.CurrentDocument;
            <tr>
                <td class="mono muted">@a.Id</td>
                <td><div class="person"><div class="avatar">@(string.IsNullOrEmpty(a.StudentName) ? "?" : a.StudentName.Substring(0, 1))</div><div><strong>@a.StudentName</strong><span class="small muted mono">@a.StudentNo</span></div></div></td>
                <td>@Ui.OrDash(a.Field("firma_adi"))</td>
                <td class="small">@Ui.Date(a.Field("staj_baslangic"))<br><span class="muted">@Ui.Date(a.Field("staj_bitis"))</span></td>
                <td>
                    @if (d != null)
                    {
                        <span class="tag">@d.KindLabel</span>
                    }
                    else
                    {
                        <span class="muted small">—</span>
                    }
                </td>
                <td class="small">
                    @if (d?.Report == null)
                    {
                        <span class="muted">—</span>
                    }
                    else if (d.Report.Ready)
                    {
                        <span class="st match">@Ui.Icon("check-circle") Hazır</span>
                    }
                    else if (d.Report.ManualReview)
                    {
                        <span class="st unread">@Ui.Icon("eye") Manuel</span>
                    }
                    else
                    {
                        <span class="st mismatch">@Ui.Icon("x-circle") @d.Report.ProblemCount sorun</span>
                    }
                </td>
                <td>@Ui.Badge(a.Status)</td>
                <td class="small muted">@Ui.Short(a.UpdatedAt)</td>
                <td><a class="btn btn-sm btn-ghost" asp-controller="Admin" asp-action="Detail" asp-route-appId="@a.Id">İncele @Ui.Icon("arrow-right")</a></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="9"><div class="empty">@Ui.Icon("file")<h3>Kayıt bulunamadı</h3><p>Filtreye uyan başvuru yok.</p></div></td></tr>
        }
        </tbody>
    </table>
</div>
